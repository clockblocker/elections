{
  "name": "@proper-app/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build src/server.ts --target=bun --outdir=dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun src/migrate.ts",
    "db:import": "bun src/import-all.ts",
    "db:import:one": "bun src/import-election.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "typescript": "7.0.2"
  }
}
